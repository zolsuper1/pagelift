# ---- General ----
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/app.db
# Behind a proxy (Render, Fly, nginx): set to 1 (number of hops) so the real client IP is used
TRUST_PROXY=

# ---- AI generation: provider chain, tried in order (server only) ----
# Free first: Groq (console.groq.com, no card), then Gemini (aistudio.google.com), then Claude (paid, optional).
AI_PROVIDERS=groq,gemini,anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_LIMIT=900
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_DAILY_LIMIT=18
# Any other OpenAI-compatible endpoint (OpenRouter, Cloudflare Workers AI...): add 'custom' to AI_PROVIDERS
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Claude (paid):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 1 = fake copy for local testing, no API calls
AI_MOCK=0

# ---- Free previews + Cloudflare Turnstile ----
PREVIEWS_PER_DAY=3
# Cloudflare's public test keys (always pass). Replace with real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Payments: mock | stripe (cardcom | payplus for Israeli merchants) ----
PAYMENT_PROVIDER=mock
CURRENCY=usd
# Stripe: secret key from Dashboard > Developers > API keys; webhook secret from the endpoint
# pointing at BASE_URL/webhooks/payment with the event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=change-me

CARDCOM_TERMINAL=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
CARDCOM_BASE_URL=https://secure.cardcom.solutions/api/v11

PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
# Sandbox: https://restapidev.payplus.co.il/api/v1.0   Live: https://restapi.payplus.co.il/api/v1.0
PAYPLUS_BASE_URL=https://restapidev.payplus.co.il/api/v1.0

# ---- Email (SMTP). Leave SMTP_HOST empty to print emails to the console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pagelift <no-reply@yourdomain.co.il>

# ---- Admin + contact ----
ADMIN_PASSWORD=
# Where the monthly plan's "Talk to us" button goes (mailto: or a booking link)
CONTACT_URL=mailto:hello@yourdomain.com
